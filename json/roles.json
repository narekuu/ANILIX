  "custom_role_template": {
    "name": "Custom Role",
    "className": "role-custom",
    "color": ["#7543D6", "#A875FF", "#7543D6"],
    "animated": true,
    "priority": 20,
    "permissions": [],
    "editable": true
  },
  "aliases": {
    "dev": "developer",
    "administrator": "admin",
    "mod": "moderator",
    "betatester": "beta",
    "user": "member"
  },
  "badge_effects": {
    "gradient_animation": true,
    "shine_animation": true,
    "shine_duration": 3000,
    "gradient_duration": 5000
  }

# Vercel Environment Variables (set in Vercel dashboard; do not commit real secrets)
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DATABASE_SSL=true
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_NAME=anilix_session
SESSION_MAX_AGE=604800000
GOOGLE_CLIENT_ID=
SANKA_API_BASE_URL=
SANKA_API_KEY=
LEVEL_EXP_REQUIRED=2150
PG_POOL_MAX=5

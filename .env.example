# Set these in Vercel Project Settings -> Environment Variables.
# Never commit real credentials or share them in chat.
APP_ENV=production
# Local SQLite path used only by the optional one-time migration script.
DATABASE_PATH=./database/anilix.db
# Use the Supabase PostgreSQL connection string (pooler is recommended for serverless).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_NAME=anilix_session
SESSION_MAX_AGE=604800000
PG_POOL_MAX=3
LEVEL_EXP_REQUIRED=2150

# Google Identity Services OAuth Web Client ID (not a client secret).
GOOGLE_CLIENT_ID=

# Existing SANKA catalog provider configuration; keep provider credentials server-side.
SANKA_API_BASE_URL=
SANKA_API_KEY=

# Optional developer test accounts. Disabled by default.
TESTER_SEED_ENABLED=false
# If explicitly enabled, provide a password OR password hash for each account.
# Never commit real passwords or hashes.
